// The key light and Lambert response every point-cloud solid shades with.
//
// SHARED SOURCE OF TRUTH. Both backends consume this file: the desktop GL passes get it
// as a constexpr string_view through the generated cube_shader_sources.h and concatenate
// it into their programs at runtime, while the browser's .vert/.frag #include it directly
// (qsb honours GL_GOOGLE_include_directive). Keep it free of uniforms, builtins and
// version-specific syntax — the two backends differ completely on all three.
//
// It is shared rather than copied because a cube, a sphere imposter and a voxel sitting
// side by side have to be lit identically, and nothing else enforces that.

const float kCubeAmbient = 0.35;
const float kCubeDiffuse = 0.65;
const vec3 kCubeKeyLightView = vec3(0.4, 0.5, 0.8);  // view space, fixed upper-right-front

float cubeLambert(vec3 normal_view) {
  return kCubeAmbient + kCubeDiffuse * max(dot(normal_view, normalize(kCubeKeyLightView)), 0.0);
}
