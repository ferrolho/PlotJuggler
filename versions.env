# Single source of truth for PJ4 versions (consumed by CMake, scripts, Docker, CI).
# PJ_APP_VERSION is deliberately 3.999.x — an ironic pre-4.0.0 beta line that sorts
# just below the first real 4.0.0 release, so the in-app update check (pj_runtime/
# UpdateChecker + UpdateVersion) flags that release as newer. Release CI overrides
# it with the git tag via PJ_VERSION; do not "correct" it to 4.0.0.
PJ_APP_VERSION=3.999.3
PJ_QT_VERSION=6.11.1
# Qt's WebAssembly kit is versioned independently from the native desktop kit.
# Qt 6.11 targets Emscripten 4.0.7; Node supplies deterministic compression.
# Keep all three exact for reproducible WebAssembly release CI.
PJ_WASM_QT_VERSION=6.11.0
PJ_EMSCRIPTEN_VERSION=4.0.7
PJ_WASM_NODE_VERSION=22.22.1
PJ_APPIMAGE_ARCH=x86_64
